# Brand Hub – směrování všech požadavků do index.php
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Přesměrování na HTTPS (odkomentujte, pokud to nedělá hosting sám)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Interní složky a soubory nejsou z webu dostupné
    RewriteRule ^(app|views|migrations)(/|$) - [F,L]
    RewriteRule ^(VERSION|data-path\.php|php\.ini|\.user\.ini|\.htaccess)$ - [F,L]

    # Existující soubory (CSS, JS, fonty) servíruj přímo, vše ostatní do aplikace
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [QSA,L]
</IfModule>

<FilesMatch "^(\.user\.ini|php\.ini|data-path\.php|VERSION)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
